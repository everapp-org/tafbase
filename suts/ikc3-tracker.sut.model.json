{
  "sut": {
    "name": "ikc3-tracker",
    "base-url": "http://127.0.0.1:4856",
    "auth": {
      "action": "log-in-with-code"
    }
  },
  "states": {
    "login": {
      "route": "/index.html?island=board",
      "marker": {
        "text": "The bus records who wrote a thought only when it knows who you are."
      }
    },
    "board": {
      "route": "/index.html?island=board",
      "marker": {
        "css": ".ikc-dock-theme"
      }
    },
    "tot": {
      "route": "/index.html?island=tot",
      "marker": {
        "css": ".ikc-dock-theme"
      }
    }
  },
  "elements": {
    "handle": {
      "label": "Handle"
    },
    "secret": {
      "label": "Secret"
    },
    "code": {
      "label": "Code"
    },
    "sign-in": {
      "role": "button",
      "name": "Sign in"
    },
    "have-a-code": {
      "role": "button",
      "name": "I have a code"
    }
  },
  "actions": {
    "log-in": {
      "from": "login",
      "to": "board",
      "title": "sign in with handle and secret",
      "do": [
        {
          "fill": {
            "element": "handle",
            "value": "env:TAF_SUT_HANDLE"
          }
        },
        {
          "fill": {
            "element": "secret",
            "value": "env:TAF_SUT_SECRET"
          }
        },
        {
          "click": "sign-in"
        },
        {
          "wait-for": {
            "state": "board"
          }
        }
      ]
    },
    "log-in-with-code": {
      "from": "login",
      "to": "board",
      "title": "sign in with a one-time code",
      "do": [
        {
          "click": "have-a-code"
        },
        {
          "fill": {
            "element": "code",
            "value": "env-pool:TAF_SUT_CODES"
          }
        },
        {
          "click": "sign-in"
        },
        {
          "wait-for": {
            "state": "board"
          }
        }
      ]
    },
    "open-board": {
      "to": "board",
      "title": "open the ticket board",
      "do": [
        {
          "navigate": "board"
        }
      ]
    },
    "open-tot": {
      "from": "board",
      "to": "tot",
      "title": "open the TOT island",
      "do": [
        {
          "navigate": "tot"
        },
        {
          "dwell": 800
        }
      ]
    }
  },
  "journeys": {
    "the-board-is-up": {
      "start": "board",
      "steps": [],
      "expect-final": {
        "state": "board"
      }
    },
    "board-to-tot": {
      "start": "board",
      "steps": [
        "open-tot"
      ],
      "expect-final": {
        "state": "tot"
      }
    }
  },
  "endpoints": {}
}
